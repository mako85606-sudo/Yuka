    "eval:extraction": "tsx --conditions=react-server scripts/eval-extraction.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "drizzle-orm": "^0.45.3",
    "motion": "14.0.0",
