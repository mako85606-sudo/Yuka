{
  "name": "loupe",
  "version": "0.1.0",
  "private": true,
  "description": "Loupe — ton devis, corrigé au stylo rouge.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
