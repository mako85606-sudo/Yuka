{
  // GitHub Codespaces : le site s'installe et se lance tout seul à l'ouverture du codespace.
  "name": "Loupe",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Loupe", "onAutoForward": "openBrowser" }
  },
  "postCreateCommand": "npm install --no-fund --no-audit",
  // À chaque ouverture : récupère les nouveautés, installe ce qui manque, lance le site.
  "postAttachCommand": "git pull --ff-only || true; npm install --no-fund --no-audit && npm run dev"
}
