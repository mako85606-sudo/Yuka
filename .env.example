# Copie ce fichier en .env.local et remplis les valeurs.
# Ne commite jamais .env.local.

# Étape 1 — planche de style /dev/design
# Masquée sur Vercel en production, sauf si cette variable vaut "true".
ENABLE_DEV_PAGES=

# Étape 3 — lecture des devis (API Claude)
# Clé à créer sur https://platform.claude.com (rubrique API keys).
# Sans clé, la page /analyse répond que l'analyse n'est pas encore ouverte.
ANTHROPIC_API_KEY=
# Facultatif : le modèle par défaut est claude-sonnet-5-5.
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Étape 3 — base Postgres (Neon ou Supabase) : limite de 5 analyses par jour, inscriptions.
# Sans base, en local, un compteur en mémoire prend le relais (remis à zéro au redémarrage).
# En production, la base est obligatoire : sans elle, l'analyse reste fermée.
# Neon : chaîne « pooled ». Supabase : « Transaction pooler » (port 6543).
DATABASE_URL=

# Étape 3 — secret du hachage des adresses IP (32 caractères au moins).
# Obligatoire en production. Pour en générer un :
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
IP_HASH_SECRET=

# Étape 6 — mesure (PostHog, hébergement EU) et page /admin
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# ADMIN_PASSWORD=
