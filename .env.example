# Copie ce fichier en .env.local et remplis les valeurs.
# Ne commite jamais .env.local.

# Étape 1 — planche de style /dev/design
# Masquée sur Vercel en production, sauf si cette variable vaut "true".
ENABLE_DEV_PAGES=

# Étape 3 — lecture des devis (API Claude)
# Clé à créer sur https://platform.claude.com (rubrique API keys).
# Sans clé, la page /analyse répond que l'analyse n'est pas encore ouverte.
ANTHROPIC_API_KEY=
# Facultatif : le modèle par défaut est claude-sonnet-5-5.
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Base Postgres (Neon ou Supabase) : limite de 5 analyses par jour, analyses (30 jours),
# lignes de prix anonymisées (24 mois), inscriptions. En local, après chaque nouvelle
# migration : npm run db:migrate. Sur Vercel, chaque déploiement les applique tout seul.
# Sans base, en local, un compteur en mémoire prend le relais (remis à zéro au redémarrage),
# et les analyses ne sont pas enregistrées (prix comparés aux seules estimations IA).
# En production, la base est obligatoire : sans elle, l'analyse reste fermée.
# Neon : chaîne « pooled ». Supabase : « Transaction pooler » (port 6543).
DATABASE_URL=

# Étape 3 — secret du hachage des adresses IP (32 caractères au moins).
# Obligatoire en production. Pour en générer un :
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
IP_HASH_SECRET=

# Étape 6 — mesure (PostHog, hébergement EU)
# Les événements passent par le serveur de Loupe (/api/events) : aucun cookie, aucune
# adresse IP transmise à PostHog. Ils sont aussi gardés dans Postgres pour /admin.
# Sans clé, ils restent dans Postgres seulement. Clé de projet (phc_…) : PostHog,
# réglages du projet. Hôte par défaut : https://eu.i.posthog.com.
POSTHOG_KEY=
# POSTHOG_HOST=https://eu.i.posthog.com

# Étape 6 — page /admin (16 caractères au moins ; sans mot de passe, /admin reste fermée)
ADMIN_PASSWORD=

# Étape 6 — adresse publique du site, pour les images de partage (« https://loupe.fr »).
# Facultative sur Vercel : l'adresse du déploiement est prise par défaut.
SITE_URL=
