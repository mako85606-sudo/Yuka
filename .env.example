# Copie ce fichier en .env.local et remplis les valeurs.
# Ne commite jamais .env.local.

# Étape 1 — planche de style /dev/design
# Masquée sur Vercel en production, sauf si cette variable vaut "true".
ENABLE_DEV_PAGES=

# Étape 3 — extraction (SDK Anthropic)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Étape 3 — base Postgres (Neon ou Supabase) pour Drizzle et le rate limit
# DATABASE_URL=

# Étape 6 — mesure (PostHog, hébergement EU) et page /admin
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# ADMIN_PASSWORD=
